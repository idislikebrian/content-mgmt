  {
    "id":38,
    "timestamp":"2025-11-19T15:27:09.958195",
    "cast_hash":"0xab71bed990bf3aa94b08402e544aef86b73a9d55",
    "text":"What if we built a CMS that didn\u2019t collapse under its own ego?",
    "world":"table",
    "window":"project_question",
    "posted":1,
    "master_cast_id":"44",
    "cid":null,
    "likes":0,
