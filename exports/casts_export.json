  },
  {
    "id":36,
    "timestamp":"2025-11-10T17:27:06.802714",
    "cast_hash":"0x3ce08373e8f15e9cbb8d46bd8b492b0e676d9947",
    "text":"The more I study Jobs, the more I realize he wasn\u2019t selling products \u2014 he was selling clarity. And clarity is expensive.",
    "world":"cobalt_confidence",
    "window":"wrap_convo_chaos",
    "posted":1,
    "master_cast_id":null,
    "cid":null,
    "likes":0,
