  },
  {
    "id":46,
    "timestamp":"2025-11-21T15:58:20.980332",
    "cast_hash":"0x34a242c1e5934cb64785ac4f0e002848fd5e9a7f",
    "text":"You can\u2019t separate the architecture from the invitation.",
