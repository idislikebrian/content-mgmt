    "last_updated":"2025-12-08T17:11:59.571869"
  },
  {
    "id":49,
    "timestamp":"2025-11-21T17:27:17.009746",
    "cast_hash":"0x4134d56250e606ca9c12ba27b76c6cbd29188b04",
    "text":"Every idea I sketch about travel ends up being a note about time.",
    "world":"caminos_building",
    "window":"wrap_convo_chaos",
