    "cast_hash":"0x082579ca765485b64a3a53fa8dc273e4bde6ac02",
    "text":"What would it mean to travel for texture instead of content?",
    "world":"travel",
    "window":"project_question",
    "posted":1,
    "master_cast_id":null,
    "cid":null,
    "likes":0,
